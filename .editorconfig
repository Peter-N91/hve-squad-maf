root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test method names use Method_Scenario underscores by convention.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
