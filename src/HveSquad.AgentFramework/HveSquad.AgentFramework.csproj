<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0-preview.1</Version>
    <Description>Run HVE Squad artifact-defined agents with Microsoft Agent Framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Peter-N91</Authors>
    <PackageProjectUrl>https://github.com/Peter-N91/hve-squad-maf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Peter-N91/hve-squad-maf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Fixed ZIP metadata epoch, not the release date or native evidence clock. -->
    <DeterministicTimestamp Condition="'$(DeterministicTimestamp)' == ''">946684800</DeterministicTimestamp>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.24.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HveSquad.AgentFramework.Tests" />
    <InternalsVisibleTo Include="HveSquad.ReleaseSync" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\compatibility\hve-squad-release.json"
                      LogicalName="HveSquad.AgentFramework.hve-squad-release.json" />
    <None Include="..\..\compatibility\hve-squad-release.json" Pack="true" PackagePath="compatibility\" />
  </ItemGroup>

</Project>
