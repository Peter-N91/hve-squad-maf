<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HveSquadPackageVersion Condition="'$(HveSquadPackageVersion)' == ''">0.1.0-preview.1</HveSquadPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HveSquad.AgentFramework" Version="$(HveSquadPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

</Project>
