{
  "repository": "YOUR-OWNER/YOUR-REPOSITORY",
  "approverHandle": "YOUR-HUMAN-APPROVER",
  "workflow": {
    "path": ".github/workflows/native-watch.yml",
    "blobSha": "0000000000000000000000000000000000000000",
    "events": ["Issue", "PullRequest", "Comment", "Schedule", "Dispatch", "Push"],
