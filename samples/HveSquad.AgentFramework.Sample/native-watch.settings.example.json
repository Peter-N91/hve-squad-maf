  "scheduleRequest": "Perform an authorized maintenance sweep.",
  "scheduleTerminal": "Issue",
  "authorizeTerminal": false,
  "terminalAuthorizationBinding": "reviewed-watch-terminal:1",
  "terminal": {
    "kinds": ["DraftPullRequest", "PullRequestReview", "SourceComment", "Issue", "CommitComment"],
    "draftHead": null,
    "draftBase": null,
    "draftHeadSha": null,
    "publishedOutputPaths": []
  },
  "costCeiling": "unset"
}
